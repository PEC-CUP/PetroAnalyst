# Experimental database runtime state
data/experimental_db/catalog/
data/experimental_db/objects/
data/experimental_db/registry/
data/experimental_db/samples/

# Optional local knowledge assets not required for the release
knowledge/papers/
knowledge/reports/
knowledge/standards/
knowledge/tool_kb/
