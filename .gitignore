.env

# Python runtime artifacts
__pycache__/
*.py[cod]
*.pyc.*
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local uploads and generated runtime outputs
app/tools/document_uploads/
data/tool_outputs/
data/logs/
outputs/
data/llm_prompt_overrides.json
